{
  "name": "classcards-ranking-tools",
  "private": true,
  "version": "1.0.0",
  "description": "Migração e testes locais das regras do ranking do Class Cards",
  "scripts": {
    "test:security": "firebase emulators:exec --only firestore --project demo-classcards-ranking --config ../../firebase.json \"node --test security.test.cjs\"",
    "test:decks": "firebase emulators:exec --only firestore --project demo-classcards-decks --config ../../firebase.json \"node --test deck-security.test.cjs\""
  },
  "dependencies": {
    "firebase-admin": "^14.5.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase": "^13.1.0",
    "firebase-tools": "^15.34.1"
  }
}
