rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Regras anteriores preservadas.
    match /users/{userId} {
      allow read, create, update: if request.auth != null && request.auth.uid == userId;
      match /progressoFlashcards/{flashcardId} {
        allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /users/{uid}/gamificacao/resumo {
      allow read, create, update: if request.auth != null && request.auth.uid == uid;
    }
    function metadadosRelatorioValidos() {
      let d = request.resource.data;
      let r = d.relatorio;
      let deck = get(/databases/$(database)/documents/decksMoodle/$(d.deckId)).data;
      return d.deckId.matches('moodle-.*')
        && d.createdAt == request.time
        && d.rating in ['AGAIN', 'HARD', 'GOOD', 'EASY']
        && r.keys().hasOnly(['cursoChave', 'materia', 'assunto', 'titulo', 'verificado'])
        && r.cursoChave == deck.cursoChave
        && (r.cursoChave in cursosMoodle() || deck.ownerId == request.auth.uid)
        && r.assunto == deck.get('assunto', '') && r.materia == deck.get('materia', '')
        && r.titulo == deck.get('titulo', '') && r.verificado == deck.get('verificadoPorProfessor', false)
        && exists(/databases/$(database)/documents/decksMoodle/$(d.deckId)/cards/$(d.flashcardId));
    }
    // Clientes antigos continuam gravando revisões; clientes novos vinculam a projeção na mesma operação.
    function publicacaoDaRevisaoValida(uid, revisaoId, modo) {
      let e = request.resource.data;
      return !('relatorioPublicoId' in e)
        || (e.relatorioPublicoId is string && e.relatorioPublicoId.matches('[a-f0-9]{64}')
            && getAfter(/databases/$(database)/documents/relatoriosCursos/$(e.relatorio.cursoChave)/revisoes/$(e.relatorioPublicoId)).data.uid == uid
            && getAfter(/databases/$(database)/documents/relatoriosCursos/$(e.relatorio.cursoChave)/revisoes/$(e.relatorioPublicoId)).data.eventoId == revisaoId
            && getAfter(/databases/$(database)/documents/relatoriosCursos/$(e.relatorio.cursoChave)/revisoes/$(e.relatorioPublicoId)).data.modo == modo);
    }
    match /users/{uid}/revisoesTradicionais/{revisaoId} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
                    && (!('relatorio' in request.resource.data) || metadadosRelatorioValidos())
                    && publicacaoDaRevisaoValida(uid, revisaoId, 'tradicional');
    }
    match /users/{uid}/revisoesDissertativas/{revisaoId} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
                    && (!('relatorio' in request.resource.data) || metadadosRelatorioValidos())
                    && publicacaoDaRevisaoValida(uid, revisaoId, 'dissertativo');
    }

    match /decks/{deckId} {
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow read: if request.auth != null;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
      match /cards/{cardId} {
        allow read: if request.auth != null;
        // getAfter também funciona na criação do deck e dos cards no mesmo lote.
        allow create, update: if request.auth != null
                              && getAfter(/databases/$(database)/documents/decks/$(deckId)).data.ownerId == request.auth.uid
                              && !getAfter(/databases/$(database)/documents/decks/$(deckId)).data.get('excluindo', false);
        allow delete: if request.auth != null
                      && get(/databases/$(database)/documents/decks/$(deckId)).data.ownerId == request.auth.uid;
      }
    }

    // Integração Moodle (Fase 9): baralhos da bolha Moodle, presos a um curso "<site>:<courseid>".
    // Só o dono e os membros do curso (claims do passe emitido pelo plugin do Moodle) leem.
    function cursosMoodle() {
      return request.auth.token.get('moodle', {}).get('cursos', []);
    }
    function professorDoCurso(curso) {
      return curso in request.auth.token.get('moodle', {}).get('prof', []);
    }
    match /decksMoodle/{deckId} {
      allow read: if request.auth != null
                  && (resource.data.ownerId == request.auth.uid || resource.data.cursoChave in cursosMoodle());
      allow create: if request.auth != null && deckId.matches('moodle-.*')
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.cursoChave in cursosMoodle()
                    && request.resource.data.get('assunto', '') is string
                    && request.resource.data.get('assunto', '').size() <= 120
                    && request.resource.data.get('verificadoPorProfessor', false) is bool
                    && (!request.resource.data.get('verificadoPorProfessor', false)
                        || professorDoCurso(request.resource.data.cursoChave));
      // Mudar de curso só para um curso da pessoa; manter o curso vale mesmo se ela saiu dele (ex.: excluir).
      allow update: if request.auth != null
                    && request.resource.data.get('assunto', '') is string
                    && request.resource.data.get('assunto', '').size() <= 120
                    && request.resource.data.get('verificadoPorProfessor', false) is bool
                    && ((resource.data.ownerId == request.auth.uid
                    && request.resource.data.ownerId == request.auth.uid
                    && (request.resource.data.cursoChave == resource.data.cursoChave
                        || request.resource.data.cursoChave in cursosMoodle())
                    && (!request.resource.data.get('verificadoPorProfessor', false)
                        || (request.resource.data.get('verificadoPorProfessor', false) == resource.data.get('verificadoPorProfessor', false)
                            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['titulo', 'materia', 'assunto', 'cursoChave', 'updatedAt']))
                        || professorDoCurso(request.resource.data.cursoChave)))
                    || (professorDoCurso(resource.data.cursoChave)
                        && !resource.data.get('excluindo', false)
                        && request.resource.data.verificadoPorProfessor == true
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verificadoPorProfessor'])));
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
      match /cards/{cardId} {
        allow read: if request.auth != null
                    && (get(/databases/$(database)/documents/decksMoodle/$(deckId)).data.ownerId == request.auth.uid
                        || get(/databases/$(database)/documents/decksMoodle/$(deckId)).data.cursoChave in cursosMoodle());
        allow create, update: if request.auth != null
                              && getAfter(/databases/$(database)/documents/decksMoodle/$(deckId)).data.ownerId == request.auth.uid
                              && !getAfter(/databases/$(database)/documents/decksMoodle/$(deckId)).data.get('excluindo', false)
                              && (!getAfter(/databases/$(database)/documents/decksMoodle/$(deckId)).data.get('verificadoPorProfessor', false)
                                  || professorDoCurso(getAfter(/databases/$(database)/documents/decksMoodle/$(deckId)).data.cursoChave));
        allow delete: if request.auth != null
                      && get(/databases/$(database)/documents/decksMoodle/$(deckId)).data.ownerId == request.auth.uid
                      && (get(/databases/$(database)/documents/decksMoodle/$(deckId)).data.get('excluindo', false)
                          || !getAfter(/databases/$(database)/documents/decksMoodle/$(deckId)).data.get('verificadoPorProfessor', false)
                          || professorDoCurso(get(/databases/$(database)/documents/decksMoodle/$(deckId)).data.cursoChave));
      }
    }

    // Um registro imutável por tentativa. O app do professor calcula os totais sem Functions.
    // O vínculo de ida e volta impede republicar uma revisão antiga com outro identificador.
    function revisaoPublicaValida(curso, publicacaoId) {
      let d = request.resource.data;
      let colecao = d.modo == 'tradicional' ? 'revisoesTradicionais' : 'revisoesDissertativas';
      let caminhoEvento = /databases/$(database)/documents/users/$(d.uid)/$(colecao)/$(d.eventoId);
      let e = getAfter(caminhoEvento).data;
      let perfil = exists(/databases/$(database)/documents/rankings/$(d.uid))
        ? get(/databases/$(database)/documents/rankings/$(d.uid)).data : {};
      let campos = ['uid', 'eventoId', 'modo', 'nome', 'fotoUrl', 'deckId', 'flashcardId',
                    'rating', 'createdAt', 'assunto', 'titulo', 'verificado'];
      return d.keys().hasAll(campos) && d.keys().hasOnly(campos)
        && d.uid == request.auth.uid && d.uid.matches('moodle-.*')
        && curso in cursosMoodle() && !professorDoCurso(curso)
        && publicacaoId.matches('[a-f0-9]{64}')
        && d.eventoId is string && d.eventoId.matches('[^/]{1,512}')
        && d.modo in ['tradicional', 'dissertativo']
        && e.relatorioPublicoId == publicacaoId
        && e.relatorio.cursoChave == curso
        && d.deckId == e.deckId && d.flashcardId == e.flashcardId
        && d.rating == e.rating && d.rating in ['AGAIN', 'HARD', 'GOOD', 'EASY']
        && d.createdAt is timestamp && d.createdAt == request.time && d.createdAt == e.createdAt
        && d.assunto == e.relatorio.assunto && d.titulo == e.relatorio.titulo
        && d.verificado == e.relatorio.verificado
        && d.nome is string && d.nome.size() > 0 && d.nome.size() <= 120
        && d.nome == perfil.get('nome', 'Estudante')
        && d.fotoUrl is string && d.fotoUrl == perfil.get('fotoUrl', '');
    }
    match /relatoriosCursos/{curso}/revisoes/{publicacaoId} {
      allow read: if request.auth != null && professorDoCurso(curso);
      allow create: if request.auth != null && revisaoPublicaValida(curso, publicacaoId);
      // Nenhum cliente edita ou apaga tentativas já publicadas.
    }
    // Agregados do processamento antigo são preservados, sem novas escritas pelo cliente.
    match /relatoriosCursos/{curso}/resumos/{resumo} {
      allow read: if request.auth != null && professorDoCurso(curso);
      allow write: if false;
    }
    match /relatoriosProcessados/{recibo} {
      allow read, write: if false;
    }

    // O avatar é pequeno e separado: consultas ao ranking nunca baixam o conteúdo da imagem.
    match /avatares/{uid} {
      allow get: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['uid', 'versao', 'conteudo', 'mimeType', 'atualizadoEm'])
        && request.resource.data.keys().hasOnly(['uid', 'versao', 'conteudo', 'mimeType', 'atualizadoEm'])
        && request.resource.data.uid == uid
        && (!exists(/databases/$(database)/documents/avatares/$(uid))
            || request.resource.data.versao != resource.data.versao)
        && request.resource.data.versao is string
        && request.resource.data.versao.matches('[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}')
        && request.resource.data.conteudo is bytes
        && request.resource.data.conteudo.size() > 0 && request.resource.data.conteudo.size() <= 51200
        && request.resource.data.mimeType == 'image/jpeg'
        && request.resource.data.atualizadoEm == request.time
        && getAfter(/databases/$(database)/documents/users/$(uid)).data.fotoUrl
            == 'avatar-firestore:' + uid + '/' + request.resource.data.versao
        && getAfter(/databases/$(database)/documents/rankings/$(uid)).data.fotoUrl
            == 'avatar-firestore:' + uid + '/' + request.resource.data.versao;
    }
    function fotoPublicaValida(uid, foto) {
      return foto == '' || foto.matches('https://.*')
        || foto == 'avatar-firestore:' + uid + '/'
          + getAfter(/databases/$(database)/documents/avatares/$(uid)).data.versao;
    }

    // A projeção publica apenas o que aparece no ranking; nunca e-mail ou respostas.
    function rankingPublicoValido(uid) {
      let d = request.resource.data;
      let resumo = getAfter(/databases/$(database)/documents/users/$(uid)/gamificacao/resumo).data;
      let campos = ['uid', 'nome', 'fotoUrl', 'xp', 'ofensiva', 'cardsEstudados',
                    'ultimoDiaEstudo', 'fusoHorario', 'atualizadoEm'];
      return d.keys().hasAll(campos)
        // Opcional para manter os clientes anteriores compatíveis; somente clientes novos o gravam.
        && d.keys().hasOnly(campos.concat(['nomeBusca', 'cursosChave']))
        // Integração Moodle (Fase 9): cursos opcionais, só os da própria carteirinha (claims) e no máximo 30.
        && (!('cursosChave' in d) || (d.cursosChave is list && d.cursosChave.size() <= 30
            && d.cursosChave.hasOnly(request.auth.token.get('moodle', {}).get('cursos', []))))
        && (!('nomeBusca' in d) || (d.nomeBusca is string && d.nomeBusca.size() <= 240))
        && d.uid == uid
        && d.nome is string && d.nome.size() > 0 && d.nome.size() <= 120
        && d.fotoUrl is string && d.fotoUrl.size() <= 4096
        && fotoPublicaValida(uid, d.fotoUrl)
        && d.xp is int && d.xp >= 0
        && d.ofensiva is int && d.ofensiva >= 0
        && d.cardsEstudados is int && d.cardsEstudados >= 0
        && d.ultimoDiaEstudo is string
        && (d.ultimoDiaEstudo == '' || d.ultimoDiaEstudo.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'))
        && d.fusoHorario is string && d.fusoHorario.size() > 0 && d.fusoHorario.size() <= 80
        && d.xp == resumo.get('xp', 0)
        && d.ofensiva == resumo.get('ofensiva', 0)
        && d.cardsEstudados == resumo.get('cardsEstudados', 0)
        && d.ultimoDiaEstudo == resumo.get('ultimoDiaEstudo', '')
        && d.fusoHorario == resumo.get('fusoHorario', '')
        && d.atualizadoEm is timestamp && d.atualizadoEm == request.time;
    }

    match /rankings/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
                            && rankingPublicoValido(uid);
    }
  }
}
