<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="Class Cards"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.ClassCardsAplicação">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ClassCardsAplicação.Splash">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- recebe o retorno do login do Moodle: classcards://token=... -->
        <activity
            android:name=".ui.auth.moodle.MoodleRetornoActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.ClassCardsAplicação">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="classcards" />
            </intent-filter>
        </activity>
    </application>

</manifest>