<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#120E1F"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/header_inset"
        android:paddingTop="@dimen/header_inset"
        android:paddingEnd="@dimen/header_inset"
        android:paddingBottom="24dp">

        <!-- Cabeçalho -->

        <!-- Pergunta -->

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">



            <TextView
                android:id="@+id/txtNomeDeck2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Nome do Deck"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/btnVoltar2"
                app:layout_constraintTop_toTopOf="@id/btnVoltar2"
                style="@style/Widget.ClassCards.HeaderTitle"
                app:layout_constraintBottom_toBottomOf="@id/btnVoltar2" />

            <androidx.appcompat.widget.AppCompatImageButton
                style="@style/Widget.ClassCards.BackButton"
                android:id="@+id/btnVoltar2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">
            <TextView
                android:id="@+id/txtContadorFlashcards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Carregando flashcards..."
                android:textColor="@color/text_secondary"
                android:textAlignment="center" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="342dp"
            android:layout_marginTop="28dp"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="@dimen/radius_card"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <TextView
                android:id="@+id/txtPergunta"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="Carregando pergunta..."
                android:textAlignment="center"
                android:textColor="@color/button_text" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/txtErroEstudo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/text_primary"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTentarNovamente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tentar novamente"
            android:visibility="gone" />

        <!-- Resposta escrita -->
        <LinearLayout
            android:id="@+id/containerResposta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sua resposta"
                android:textColor="@android:color/white"
                android:textSize="17sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputLayoutResposta"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:boxBackgroundColor="#21182E"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusTopStart="16dp"
                app:boxStrokeColor="@color/border"
                app:hintTextColor="@color/button_border">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editResposta"
                    android:layout_width="match_parent"
                    android:layout_height="167dp"
                    android:background="@drawable/button_preto_background"
                    android:gravity="top|start"
                    android:hint="Digite sua resposta aqui..."
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLength="6000"
                    android:maxLines="10"
                    android:minLines="5"
                    android:padding="16dp"
                    android:textColor="@android:color/white"
                    android:textColorHint="@color/button_secundary"
                    android:textSize="16sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAvaliarResposta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:minHeight="52dp"
                android:text="Avaliar resposta"
                android:textAllCaps="false"
                android:textColor="@color/button_text"
                android:textSize="16sp"
                app:backgroundTint="@color/button_primary"
                app:cornerRadius="@dimen/button_radius"
                app:strokeColor="@color/button_border"
                app:strokeWidth="1dp" />

        </LinearLayout>

        <!-- Carregamento da IA -->
        <LinearLayout
            android:id="@+id/containerCarregamento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/progressAvaliacao"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:indeterminateTint="#C9A1DD" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:id="@+id/txtStatusAvaliacao"
                android:text="A IA está avaliando sua resposta..."
                android:textColor="@android:color/white"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Resultado da IA -->
        <LinearLayout
            android:id="@+id/containerResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Resposta esperada"
                        android:textColor="@android:color/white"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtRespostaEsperada"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="@android:color/white"
                        android:textSize="15sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="20dp"
                        android:background="#9B75B1" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Análise da IA"
                        android:textColor="@android:color/white"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtExplicacaoIA"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="@android:color/white"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/txtSugestaoIA"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:visibility="gone"
                        android:textColor="#F0D4FF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/containerAvaliacaoFinal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
            <!-- Avaliação final do estudante -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:text="Como você avalia sua resposta?"
                android:textColor="@android:color/white"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Você pode aceitar ou alterar a sugestão da IA."
                android:textColor="#C9BED5"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnErrei"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="Errei"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    app:backgroundTint="#8B354B"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDificil"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="Difícil"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    app:backgroundTint="#86512E"
                    app:cornerRadius="12dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBom"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="Bom"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    app:backgroundTint="#325F8B"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFacil"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="Fácil"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    app:backgroundTint="#286C53"
                    app:cornerRadius="12dp" />

            </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
