<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    tools:context=".ui.deck.details.DeckSelecionadoFragment">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardModoDissertativo"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:background="@drawable/arredondado_flash_card"
        app:cardBackgroundColor="@color/card_background"
        app:cardCornerRadius="@dimen/radius_card"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardModoTradicional"
        app:strokeColor="@android:color/transparent"
        app:strokeWidth="0dp">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDissertativo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:text="Estudar"
                android:textColor="@color/button_text"
                app:backgroundTint="@color/button_primary"
                app:cornerRadius="@dimen/button_radius"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView15"
                app:strokeColor="@color/button_border"
                app:strokeWidth="1dp" />

            <TextView
                android:id="@+id/textView11"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="28dp"
                android:backgroundTint="@color/error"
                android:text="Dissertativo"
                android:textColor="@color/button_text"
                android:textSize="@dimen/text_section_title"
                app:layout_constraintBottom_toTopOf="@+id/textView15"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/textView15"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="28dp"
                android:backgroundTint="@color/error"
                android:text="Receba uma avaliação da IA e conquiste XP."
                android:textColor="@color/button_text"
                android:textSize="@dimen/text_secondary"
                app:layout_constraintBottom_toTopOf="@+id/btnDissertativo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView11" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardModoTradicional"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="50dp"
        android:layout_marginEnd="32dp"
        android:background="@drawable/arredondado_flash_card"
        app:cardBackgroundColor="@color/card_background"
        app:cardCornerRadius="@dimen/radius_card"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toTopOf="@id/cardModoDissertativo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView13"
        app:strokeColor="@android:color/transparent"
        app:strokeWidth="0dp">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTradicional"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:text="Estudar"
                android:textColor="@color/button_text"
                app:backgroundTint="@color/button_primary"
                app:cornerRadius="@dimen/button_radius"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView14"
                app:strokeColor="@color/button_border"
                app:strokeWidth="1dp" />

            <TextView
                android:id="@+id/textView14"
                android:layout_width="248dp"
                android:layout_height="33dp"
                android:layout_marginStart="28dp"
                android:backgroundTint="@color/error"
                android:text="Revele a resposta e avalie o quanto você se lembrou."
                android:textColor="@color/button_text"
                android:textSize="@dimen/text_secondary"
                app:layout_constraintBottom_toTopOf="@+id/btnTradicional"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView5" />

            <TextView
                android:id="@+id/textView5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="28dp"
                android:backgroundTint="@color/error"
                android:text="Tradicional"
                android:textColor="@color/button_text"
                android:textSize="@dimen/text_section_title"
                app:layout_constraintBottom_toTopOf="@+id/textView14"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/linearLayout2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/header_inset"
        android:paddingTop="@dimen/header_inset"
        android:paddingEnd="@dimen/header_inset"
        android:paddingBottom="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- TOPO -->

        <LinearLayout
            style="@style/Widget.ClassCards.HeaderRow">

            <androidx.appcompat.widget.AppCompatImageButton
                style="@style/Widget.ClassCards.BackButton"
                android:id="@+id/btnVoltar" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Deck"
                style="@style/Widget.ClassCards.HeaderTitle"
                android:layout_weight="1" />

        </LinearLayout>


        <!-- NOME DO DECK -->


        <!-- MATÉRIA -->


        <!-- INFORMAÇÕES -->


        <!-- ESTUDAR -->


        <!-- EDITAR -->

    </LinearLayout>

    <TextView
        android:id="@+id/textView13"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="64dp"
        android:layout_marginEnd="63dp"
        android:backgroundTint="@color/error"
        android:text="Escolha seu modo de estudo"
        android:textColor="@color/button_text"
        android:textSize="@dimen/text_section_title"
        app:layout_constraintBottom_toTopOf="@id/cardModoTradicional"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout2"
        app:layout_constraintVertical_bias="0.772" />

</androidx.constraintlayout.widget.ConstraintLayout>