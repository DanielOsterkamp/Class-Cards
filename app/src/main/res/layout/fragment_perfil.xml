<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    tools:context=".ui.profile.PerfilFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="700dp">

        <!-- Menu -->

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="@dimen/screen_horizontal_margin"
            android:layout_marginTop="@dimen/spacing_md"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Abrir menu"
            android:padding="@dimen/spacing_smd"
            android:scaleType="centerCrop"
            android:src="@drawable/menu_hamburguer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/text_primary" />

        <!-- Foto -->

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgPerfil"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="@dimen/spacing_lg"
            android:contentDescription="Foto de perfil"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/CircleImage"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnMenu"
            tools:src="@drawable/logo_transparente_pequeno" />

        <!-- Nome -->

        <TextView
            android:id="@+id/txtNomeUsuario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_section_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imgPerfil"
            tools:text="Rodrigo Remor" />

        <!-- Estatísticas do usuário -->
        <LinearLayout
            android:id="@+id/layoutGamificacao"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_horizontal_margin"
            android:layout_marginEnd="@dimen/screen_horizontal_margin"
            android:layout_marginTop="@dimen/spacing_lg"
            android:baselineAligned="false"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtNomeUsuario">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardOfensiva"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/button_preto_background"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/txtOfensiva"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="—"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_title"
                        app:autoSizeMaxTextSize="32sp"
                        app:autoSizeMinTextSize="12sp"
                        app:autoSizeStepGranularity="1sp"
                        app:autoSizeTextType="uniform" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:gravity="top|center_horizontal"
                        android:text="Ofensiva"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEstudados"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/button_preto_background"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/txtQuantidadeEstudados"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="—"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_title"
                        app:autoSizeMaxTextSize="32sp"
                        app:autoSizeMinTextSize="12sp"
                        app:autoSizeStepGranularity="1sp"
                        app:autoSizeTextType="uniform" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:gravity="top|center_horizontal"
                        android:text="Cards estudados"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardXp"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/button_preto_background"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/txtXp"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="—"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_title"
                        app:autoSizeMaxTextSize="32sp"
                        app:autoSizeMinTextSize="12sp"
                        app:autoSizeStepGranularity="1sp"
                        app:autoSizeTextType="uniform" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:gravity="top|center_horizontal"
                        android:text="Pontos"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Decks criados -->

        <TextView
            android:id="@+id/txtTituloDecks"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_horizontal_margin"
            android:layout_marginTop="@dimen/spacing_xl"
            android:layout_marginEnd="@dimen/screen_horizontal_margin"
            android:fontFamily="sans-serif-medium"
            android:text="Decks criados por você"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_section_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutGamificacao" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerDecksUsuario"
            android:layout_width="0dp"
            android:layout_height="180dp"
            android:layout_marginTop="@dimen/spacing_md"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingStart="@dimen/screen_horizontal_margin"
            android:paddingEnd="@dimen/screen_horizontal_margin"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtTituloDecks" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>