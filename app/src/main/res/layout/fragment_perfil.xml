<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    tools:context=".ui.profile.PerfilFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="700dp">

        <!-- Menu -->

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="@dimen/screen_horizontal_margin"
            android:layout_marginTop="@dimen/spacing_md"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Abrir menu"
            android:padding="@dimen/spacing_smd"
            android:scaleType="centerCrop"
            android:src="@drawable/menu_hamburguer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/text_primary" />

        <!-- Foto -->

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgPerfil"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="@dimen/spacing_lg"
            android:contentDescription="Foto de perfil"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/CircleImage"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnMenu"
            tools:src="@drawable/logo_transparente_pequeno" />

        <!-- Nome -->

        <TextView
            android:id="@+id/txtNomeUsuario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_section_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imgPerfil"
            tools:text="Rodrigo Remor" />

        <!-- Estatística -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardEstudados"
            android:layout_width="0dp"
            android:layout_height="110dp"
            android:layout_marginStart="@dimen/screen_horizontal_margin"
            android:layout_marginTop="@dimen/spacing_lg"
            android:layout_marginEnd="@dimen/screen_horizontal_margin"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="@dimen/radius_card"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtNomeUsuario">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/button_preto_background"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtQuantidadeEstudados"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_title"
                    tools:text="102" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="Cards estudados"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_secondary" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Decks criados -->

        <TextView
            android:id="@+id/txtTituloDecks"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_horizontal_margin"
            android:layout_marginTop="@dimen/spacing_xl"
            android:layout_marginEnd="@dimen/screen_horizontal_margin"
            android:fontFamily="sans-serif-medium"
            android:text="Decks criados por você"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_section_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardEstudados" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerDecksUsuario"
            android:layout_width="0dp"
            android:layout_height="180dp"
            android:layout_marginTop="@dimen/spacing_md"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingStart="@dimen/screen_horizontal_margin"
            android:paddingEnd="@dimen/screen_horizontal_margin"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtTituloDecks" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>