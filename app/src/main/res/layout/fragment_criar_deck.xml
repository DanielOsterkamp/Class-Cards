<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    tools:context=".ui.deck.create.CriarDeckFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/header_inset"
        android:paddingTop="@dimen/header_inset"
        android:paddingEnd="@dimen/header_inset"
        android:paddingBottom="@dimen/spacing_xl">

        <!-- TOPO -->

        <LinearLayout
            style="@style/Widget.ClassCards.HeaderRow">

            <androidx.appcompat.widget.AppCompatImageButton
                style="@style/Widget.ClassCards.BackButton"
                android:id="@+id/btnVoltar" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Criar Deck"
                style="@style/Widget.ClassCards.HeaderTitle"
                android:layout_weight="1" />

        </LinearLayout>


        <!-- NOME -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="Nome"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body" />

        <EditText
            android:id="@+id/inputNomeDeck"
            android:layout_width="match_parent"
            android:layout_height="@dimen/input_height"
            android:layout_marginTop="@dimen/spacing_sm"
            android:background="@drawable/button_preto_background"
            android:hint="Nome do deck"
            android:paddingStart="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_md"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary" />


        <!-- MATÉRIA -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="Matéria"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body" />

        <EditText
            android:id="@+id/inputMateriaDeck"
            android:layout_width="match_parent"
            android:layout_height="@dimen/input_height"
            android:layout_marginTop="@dimen/spacing_sm"
            android:background="@drawable/button_preto_background"
            android:hint="Ex.: Biologia"
            android:paddingStart="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_md"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary" />


        <!-- SWITCH MANUAL / AUTOMÁTICO -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtManual"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Manual"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchModoCriacao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_md"
                android:layout_marginEnd="@dimen/spacing_md"
                android:contentDescription="Alterar modo de criação" />

            <TextView
                android:id="@+id/txtAutomatico"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Automático"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_body" />

        </LinearLayout>


        <!-- ========================= -->
        <!-- MODO MANUAL -->
        <!-- ========================= -->

        <LinearLayout
            android:id="@+id/containerManual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:text="Pergunta"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body" />

            <EditText
                android:id="@+id/inputPergunta"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="@dimen/spacing_sm"
                android:background="@drawable/button_preto_background"
                android:gravity="top|start"
                android:hint="Digite a pergunta"
                android:inputType="textMultiLine"
                android:padding="@dimen/spacing_md"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="Resposta"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body" />

            <EditText
                android:id="@+id/inputResposta"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="@dimen/spacing_sm"
                android:background="@drawable/button_preto_background"
                android:gravity="top|start"
                android:hint="Digite a resposta"
                android:inputType="textMultiLine"
                android:padding="@dimen/spacing_md"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary" />


            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCriarFlashcard"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="Criar Flash Card"
                android:textColor="@color/button_text"
                app:backgroundTint="@color/card_background"
                app:cornerRadius="@dimen/button_radius" />

        </LinearLayout>


        <!-- ========================= -->
        <!-- MODO AUTOMÁTICO -->
        <!-- ========================= -->

        <LinearLayout
            android:id="@+id/containerAutomatico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:text="Número de cards"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body" />

            <EditText
                android:id="@+id/inputNumeroCards"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:layout_marginTop="@dimen/spacing_sm"
                android:background="@drawable/button_preto_background"
                android:hint="Ex.: 10"
                android:inputType="number"
                android:paddingStart="@dimen/spacing_md"
                android:paddingEnd="@dimen/spacing_md"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="Descrição"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body" />

            <EditText
                android:id="@+id/inputDescricaoIA"
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:layout_marginTop="@dimen/spacing_sm"
                android:background="@drawable/button_preto_background"
                android:gravity="top|start"
                android:hint="Descreva o conteúdo dos flashcards"
                android:inputType="textMultiLine"
                android:padding="@dimen/spacing_md"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary" />


            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGerarFlashcards"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="Gerar Flash Cards"
                android:textColor="@color/button_text"
                app:backgroundTint="@color/card_background"
                app:cornerRadius="@dimen/button_radius" />

        </LinearLayout>


        <!-- Mesmo indicador indeterminado usado no estudo dissertativo. -->
        <LinearLayout
            android:id="@+id/containerCarregamentoCriacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/progressGeracaoFlashcards"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:indeterminate="true"
                android:indeterminateTint="#C9A1DD" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:accessibilityLiveRegion="polite"
                android:text="@string/gerando_flashcards_ia"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- FLASHCARDS DO DECK -->

        <TextView
            android:id="@+id/txtFlashcardsCriados"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:fontFamily="sans-serif-medium"
            android:text="Flashcards"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_section_title" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerFlashcards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:nestedScrollingEnabled="false" />


        <!-- SALVAR -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSalvarDeck"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/spacing_xl"
            android:text="Salvar Deck"
            android:textColor="@color/button_text"
            app:backgroundTint="@color/button_primary"
            app:cornerRadius="@dimen/button_radius"
            app:strokeColor="@color/button_border"
            app:strokeWidth="1dp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>