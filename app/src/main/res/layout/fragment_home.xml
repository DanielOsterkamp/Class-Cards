<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".ui.home.HomeFragment">

    <ImageButton
        android:id="@+id/btnMenu"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="@dimen/header_inset"
        android:layout_marginTop="@dimen/header_inset"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Abrir menu"
        android:padding="@dimen/spacing_smd"
        android:scaleType="centerCrop"
        android:src="@drawable/menu_hamburguer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/text_primary" />

    <TextView
        android:id="@+id/txtTituloHome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Class Cards"
        app:layout_constraintBottom_toBottomOf="@id/btnMenu"
        app:layout_constraintStart_toEndOf="@id/btnMenu"
        app:layout_constraintTop_toTopOf="@id/btnMenu"
        style="@style/Widget.ClassCards.HeaderTitle"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="@dimen/header_inset" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCriarDeck"
        android:layout_width="0dp"
        android:layout_height="@dimen/button_height"
        android:layout_marginStart="@dimen/screen_horizontal_margin"
        android:layout_marginTop="@dimen/spacing_lg"
        android:layout_marginEnd="@dimen/screen_horizontal_margin"
        android:text="Criar Deck"
        android:textColor="@color/button_text"
        app:backgroundTint="@color/button_primary"
        app:cornerRadius="@dimen/button_radius"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnMenu"
        app:strokeColor="@color/button_border"
        app:strokeWidth="1dp" />

    <TextView
        android:id="@+id/txtSeusDecks"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_horizontal_margin"
        android:layout_marginTop="@dimen/spacing_lg"
        android:text="Cards criados por você"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_section_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnCriarDeck" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerSeusDecks"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/spacing_md"
        android:clipToPadding="false"
        android:paddingStart="@dimen/screen_horizontal_margin"
        android:paddingEnd="@dimen/screen_horizontal_margin"
        android:paddingBottom="@dimen/spacing_md"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtSeusDecks"
        tools:listitem="@layout/item_deck" />

</androidx.constraintlayout.widget.ConstraintLayout>