<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    tools:context=".ui.deck.details.DeckSelecionadoFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_horizontal_margin"
        android:paddingTop="@dimen/spacing_md"
        android:paddingEnd="@dimen/screen_horizontal_margin"
        android:paddingBottom="@dimen/spacing_xl">

        <!-- TOPO -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Abrir menu"
                android:padding="@dimen/spacing_smd"
                android:scaleType="centerCrop"
                android:src="@drawable/menu_hamburguer"
                app:tint="@color/text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_md"
                android:fontFamily="sans-serif-medium"
                android:text="Deck"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_section_title" />

        </LinearLayout>


        <!-- NOME DO DECK -->

        <TextView
            android:id="@+id/txtNomeDeck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_title"
            tools:text="Biologia Celular" />


        <!-- MATÉRIA -->

        <TextView
            android:id="@+id/txtMateriaDeck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body"
            tools:text="Biologia" />


        <!-- INFORMAÇÕES -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="@dimen/radius_card"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Flashcards"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_small" />

                <TextView
                    android:id="@+id/txtQuantidadeCards"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_emphasis"
                    tools:text="24 cards" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ESTUDAR -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEstudar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/spacing_xl"
            android:text="Estudar"
            android:textColor="@color/button_text"
            app:backgroundTint="@color/card_background"
            app:cornerRadius="@dimen/button_radius" />


        <!-- EDITAR -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditarDeck"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="Editar Deck"
            android:textColor="@color/button_text"
            app:backgroundTint="@color/button_primary"
            app:cornerRadius="@dimen/button_radius"
            app:strokeColor="@color/button_border"
            app:strokeWidth="1dp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>