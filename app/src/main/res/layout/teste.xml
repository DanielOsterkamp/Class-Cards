<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EBDBDB"
    android:backgroundTint="#EBDBDB"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/titulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="82dp"
        android:layout_marginTop="34dp"
        android:layout_marginEnd="83dp"
        android:fontFamily="monospace"
        android:text="Contador de Truco"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/pontuacaoMaxima"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="106dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="105dp"
        android:fontFamily="monospace"
        android:hint="Pontuação máxima"
        android:inputType="number"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titulo" />

    <!-- Jogador 1 -->

    <Button
        android:id="@+id/iniciarPartida"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="105dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="106dp"
        android:backgroundTint="#E91E63"
        android:fontFamily="monospace"
        android:text="Iniciar partida"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pontuacaoMaxima" />

    <!-- Jogador 2 -->

    <EditText
        android:id="@+id/nomeJogador1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="105dp"
        android:layout_marginTop="41dp"
        android:layout_marginEnd="106dp"
        android:fontFamily="monospace"
        android:hint="Nome do jogador 1"
        android:inputType="text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iniciarPartida" />

    <TextView
        android:id="@+id/pontuacaoJogador1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="196dp"
        android:layout_marginEnd="196dp"
        android:fontFamily="monospace"
        android:text="0"
        android:textAlignment="center"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/nomeJogador1" />

    <Button
        android:id="@+id/diminuirJogador1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="96dp"
        android:layout_marginTop="15dp"
        android:layout_marginEnd="20dp"
        android:backgroundTint="#E91E63"
        android:fontFamily="monospace"
        android:text="-1"
        app:layout_constraintEnd_toStartOf="@+id/aumentarJogador1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pontuacaoJogador1" />

    <Button
        android:id="@+id/aumentarJogador1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="15dp"
        android:layout_marginEnd="95dp"
        android:backgroundTint="#E91E63"
        android:fontFamily="monospace"
        android:text="+1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/diminuirJogador1"
        app:layout_constraintTop_toBottomOf="@+id/pontuacaoJogador1" />

    <EditText
        android:id="@+id/nomeJogador2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="105dp"
        android:layout_marginTop="38dp"
        android:layout_marginEnd="105dp"
        android:fontFamily="monospace"
        android:hint="Nome do jogador 2"
        android:inputType="text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/aumentarJogador1" />

    <TextView
        android:id="@+id/pontuacaoJogador2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:fontFamily="monospace"
        android:text="0"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@+id/diminuirJogador2"
        app:layout_constraintTop_toBottomOf="@+id/nomeJogador2" />

    <Button
        android:id="@+id/diminuirJogador2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="97dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="20dp"
        android:backgroundTint="#E91E63"
        android:fontFamily="monospace"
        android:text="-1"
        app:layout_constraintEnd_toStartOf="@+id/aumentarJogador2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pontuacaoJogador2" />

    <Button
        android:id="@+id/aumentarJogador2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="96dp"
        android:backgroundTint="#E91E63"
        android:fontFamily="monospace"
        android:text="+1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/diminuirJogador2"
        app:layout_constraintTop_toBottomOf="@+id/pontuacaoJogador2" />

    <Button
        android:id="@+id/reiniciarPartida"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="105dp"
        android:layout_marginTop="37dp"
        android:layout_marginEnd="105dp"
        android:backgroundTint="#E91E63"
        android:fontFamily="monospace"
        android:text="Reiniciar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/diminuirJogador2" />

</androidx.constraintlayout.widget.ConstraintLayout>